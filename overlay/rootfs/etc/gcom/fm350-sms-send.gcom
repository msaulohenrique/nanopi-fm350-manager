opengt
 set com 115200n81
 set comecho off
 set senddelay 0.02
 waitquiet 0.2 0.2

 send "AT+CMEE=2^m"
 waitfor 10 "OK","ERROR"
 if % != 0 goto error

 send "AT+CMGF=1^m"
 waitfor 10 "OK","ERROR"
 if % != 0 goto error

 send "AT+CSCS=\"GSM\"^m"
 waitfor 10 "OK","ERROR"
 if % != 0 goto error

 send "AT+CMGS=\""
 send $env("SMS_NUMBER")
 send "\"^m"
 waitfor 15 ">","ERROR"
 if % != 0 goto error

 send $env("SMS_TEXT")
 send "^Z"
 waitfor 90 "OK","ERROR"
 if % != 0 goto error
 exit 0

:error
 exit 1
