#!/bin/sh

# The FM350 is the WAN. The only RJ45 serves the downstream router and also
# provides a stable maintenance address.

# FriendlyWrt/OpenWrt commonly ships an anonymous @dropbear[0] section. Replace
# every inherited Dropbear section with one explicit maintenance-only section so
# the security options below always configure the server that actually runs.
[ -e /etc/config/dropbear ] || : >/etc/config/dropbear
while uci -q delete 'dropbear.@dropbear[0]' >/dev/null 2>&1; do :; done
uci -q delete dropbear.main >/dev/null 2>&1 || true

uci -q batch <<'EOF'
delete network.wan
delete network.wan6
delete network.lan
set network.maintenance=interface
set network.maintenance.proto='static'
set network.maintenance.device='eth0'
set network.maintenance.ipaddr='192.168.77.1'
set network.maintenance.netmask='255.255.255.0'
set network.maintenance.defaultroute='0'
set network.maintenance.peerdns='0'
set network.maintenance.delegate='0'

set network.cellular=interface
set network.cellular.proto='xmm'
set network.cellular.apn='surf.br'
set network.cellular.pdp='IP'
set network.cellular.profile='1'
set network.cellular.delay='10'
set network.cellular.maxfail='20'
set network.cellular.defaultroute='1'
set network.cellular.peerdns='1'
set network.cellular.metric='10'

delete dhcp.lan
delete dhcp.wan
set dhcp.maintenance=dhcp
set dhcp.maintenance.interface='maintenance'
set dhcp.maintenance.ignore='0'
set dhcp.maintenance.start='100'
set dhcp.maintenance.limit='50'
set dhcp.maintenance.leasetime='12h'
set dhcp.maintenance.dhcpv4='server'
set dhcp.maintenance.dhcpv6='disabled'
set dhcp.maintenance.ra='disabled'
set dhcp.maintenance.ndp='disabled'

# Public images never enable root password authentication over SSH. Key-based
# SSH remains available when AUTHORIZED_KEYS is injected in a trusted build.
set dropbear.main=dropbear
set dropbear.main.PasswordAuth='off'
set dropbear.main.RootPasswordAuth='off'
set dropbear.main.Interface='maintenance'

set system.@system[0].hostname='nanopi-neo3-plus'
set system.@system[0].zonename='America/Sao_Paulo'
set system.@system[0].timezone='<-03>3'
set system.sys_led=led
set system.sys_led.name='System heartbeat'
set system.sys_led.sysfs='sys_led'
set system.sys_led.trigger='heartbeat'
set system.cellular_led=led
set system.cellular_led.name='FM350 cellular activity'
set system.cellular_led.sysfs='user_led'
set system.cellular_led.trigger='netdev'
set system.cellular_led.dev='eth1'
set system.cellular_led.mode='link tx rx'

delete uhttpd.main.listen_http
add_list uhttpd.main.listen_http='192.168.77.1:80'
delete uhttpd.main.listen_https
add_list uhttpd.main.listen_https='192.168.77.1:443'
set uhttpd.main.redirect_https='1'
EOF

lan_zone=$(uci show firewall | sed -n "s/^\(firewall\.[^.]*\)\.name='lan'$/\1/p" | head -n1)
if [ -n "$lan_zone" ]; then
	uci -q del_list "$lan_zone.network=lan"
	uci -q del_list "$lan_zone.network=maintenance"
	uci add_list "$lan_zone.network=maintenance"
fi

wan_zone=$(uci show firewall | sed -n "s/^\(firewall\.[^.]*\)\.name='wan'$/\1/p" | head -n1)
if [ -n "$wan_zone" ]; then
	uci -q del_list "$wan_zone.network=wan"
	uci -q del_list "$wan_zone.network=wan6"
	uci -q del_list "$wan_zone.network=maintenance"
	uci -q del_list "$wan_zone.network=cellular"
	uci add_list "$wan_zone.network=cellular"
fi

# Remove rules from images that previously treated maintenance as WAN. The LAN
# zone accepts device management and its existing lan-to-wan forwarding sends
# clients through the masqueraded cellular zone.
for name in Maintenance-SSH-LuCI Maintenance-DNS Maintenance-Ping Maintenance-to-Cellular; do
	for rule in $(uci show firewall | sed -n "s/^\(firewall\.[^.]*\)\.name='$name'$/\1/p"); do
		uci delete "$rule"
	done
done

uci commit network
uci commit dhcp
uci commit firewall
uci commit dropbear
uci commit system
uci commit uhttpd

# A unique per-device API token is generated on first boot and can be managed
# from Network -> FM350 Manager -> Telemetry API. The API is limited to the
# maintenance listener and also requires X-API-Key.
/usr/sbin/fm350-api-token ensure >/dev/null 2>&1 || true

/etc/init.d/fm350-autoconfig enable
/etc/init.d/led restart 2>/dev/null || true
logger -t firstboot 'NanoPi NEO3 Plus: secure FM350 WAN, routed RJ45 LAN and telemetry API configured'
exit 0
