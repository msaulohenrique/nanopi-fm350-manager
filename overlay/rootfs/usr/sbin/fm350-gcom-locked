#!/bin/sh

# Serialize netifd/XMM AT sessions with the same lock used by the FM350 LuCI
# helpers. Environment variables such as DEVPORT, CID, APN and PINCODE are
# inherited by gcom unchanged. FM350_AT_LOCK_DIR is intended for isolated tests;
# production callers use the shared /tmp/fm350-at.lock default.
lock_dir=${FM350_AT_LOCK_DIR:-/tmp/fm350-at.lock}
max_wait=${FM350_AT_LOCK_WAIT:-30}
waited=0
lock_held=0

cleanup() {
	if [ "$lock_held" = 1 ]; then
		rmdir "$lock_dir" 2>/dev/null || true
		lock_held=0
	fi
}
trap cleanup 0
trap 'cleanup; exit 1' 1 2 15

while ! mkdir "$lock_dir" 2>/dev/null; do
	waited=$((waited + 1))
	if [ "$waited" -ge "$max_wait" ]; then
		echo 'Timed out waiting for the FM350 AT port lock' >&2
		# xmm.sh treats rc=1 as an AT-port/probe failure. Reuse that semantic
		# instead of returning an unhandled custom status that could let setup
		# continue after the final probe attempt.
		exit 1
	fi
	sleep 1
done
lock_held=1

gcom "$@"
rc=$?
cleanup
exit "$rc"
