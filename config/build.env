# shellcheck shell=bash

# "latest" follows the highest FriendlyWrt master-v* branch that contains
# rk3528.xml. Set FRIENDLYWRT_VERSION_OVERRIDE in CI or locally to pin one run.
FRIENDLYWRT_VERSION=latest
FRIENDLYWRT_MANIFEST=rk3528.xml
FRIENDLYWRT_MANIFEST_REPOSITORY=https://github.com/friendlyarm/friendlywrt_manifests.git
FRIENDLYWRT_PROJECT_BASE_URL=https://github.com/friendlyarm

# Only these two packages are copied from modemfeed.
MODEMFEED_REPOSITORY=https://github.com/koshev-msk/modemfeed.git
MODEMFEED_REF=refs/heads/master

# Official FriendlyELEC build tooling. Commits are resolved for every release
# and recorded in source-lock.json.
BUILD_ENV_REPOSITORY=https://github.com/friendlyarm/build-env-on-ubuntu-bionic.git
BUILD_ENV_REF=refs/heads/master
REPO_TOOL_REPOSITORY=https://github.com/friendlyarm/repo.git
REPO_TOOL_REF=refs/heads/master

# The raw image is 3,584 MB. Building is split into two jobs to remain below
# the six-hour GitHub-hosted job limit.
MIN_FREE_DISK_GB=35
